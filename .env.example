# Required
BOT_TOKEN=
GOOGLE_SPREADSHEET_ID=

# Service account JSON can be provided as a file path, raw JSON (single line), or base64 string.
# Recommended for servers: point to a file placed under ./keys/service_account.json
GOOGLE_SERVICE_ACCOUNT_JSON=./keys/service_account.json

# Optional (defaults shown)
DB_PATH=./data/app.db
LOG_LEVEL=INFO
SENTRY_DSN=
TIMEZONE=Europe/Moscow
LOG_JOINS_WITHOUT_INVITE=true
GSHEETS_SELF_CHECK=true

# Optional: membership journal. Every join, leave and join request also goes to
# Postgres (tg_parser, schema srm) for invite attribution; the sheet is unaffected.
# Empty keeps it off. Example: postgresql://srm_writer:<password>@127.0.0.1:5432/tgparser
EVENT_JOURNAL_DSN=
